{
  "info": {
    "name": "CashFlow - User API 테스트",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 등록 성공 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Chen Lei\",\n  \"email\": \"chen.{{$timestamp}}@test.com\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.test('id 존재', () => pm.expect(b.id).to.be.a('number'));",
              "pm.test('name/email 일치', () => { pm.expect(b.name).to.eql('Chen Lei'); pm.expect(b.email).to.include('@test.com'); });",
              "pm.collectionVariables.set('userId', b.id);",
              "pm.collectionVariables.set('userEmail', b.email);"
            ]
          }
        }
      ]
    },
    {
